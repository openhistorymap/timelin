{
  "name": "@openhistorymap/timeline-react",
  "version": "0.1.0",
  "description": "React binding for the OpenHistoryMap deep-time interactive timeline.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://timel.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/openhistorymap/timel.in.git",
    "directory": "packages/react"
  },
  "keywords": ["timeline", "react", "history", "openhistorymap", "wikidata"],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@openhistorymap/timeline-core": "^0.1.0",
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@openhistorymap/timeline-core": "*",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
